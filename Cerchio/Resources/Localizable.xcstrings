    "camera.permission.message" : {
      "comment" : "Camera permission message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To save memorable pages from your books, camera access is needed.\n\nPlease enable camera permission in Settings."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "책의 인상 깊은 페이지를 촬영하여 저장하기 위해 카메라 권한이 필요합니다.\n\n설정에서 카메라 접근을 허용해주세요."
          }
        }
      }
    },
    "camera.permission.title" : {
      "comment" : "Camera permission title",
